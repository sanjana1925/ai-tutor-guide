# Google Gemini API key (required)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: if set, /upload, /agent and /documents need an X-API-Key header
API_KEY=

# Password for the System Benchmark on the Evaluation page (stays locked while empty)
BENCHMARK_PASSWORD=

# LangSmith tracing (optional). Put the real key in .env only.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=ai-tutor-guide
